<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#0B0B0C">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchTethered"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:checked="true"
        android:text="@string/mode_simulator"
        android:textColor="#D6D6D6"
        android:textSize="13sp" />

    <!-- Connection state, one line each, so a failure is attributable -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:padding="12dp"
        android:background="#16171A">

        <TextView
            android:id="@+id/textSdk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sdk_starting"
            android:textColor="#D6D6D6"
            android:textSize="13sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/textDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_device"
            android:textColor="#D6D6D6"
            android:textSize="13sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/textApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_unknown"
            android:textColor="#D6D6D6"
            android:textSize="13sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/textWatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/watch_unknown"
            android:textColor="#35A97A"
            android:textSize="13sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Actions, one per protocol step -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/buttonRefresh"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/action_refresh" />

        <Button
            android:id="@+id/buttonOpenApp"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/action_open_app" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonHello"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/action_hello" />

        <Button
            android:id="@+id/buttonPing"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/action_ping" />
    </LinearLayout>

    <Button
        android:id="@+id/buttonFix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:backgroundTint="#007A49"
        android:text="@string/action_fix"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/buttonStore"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:text="@string/action_store" />

    <!-- The point itself, at full precision -->
    <TextView
        android:id="@+id/textPoint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:padding="12dp"
        android:background="#16171A"
        android:text="@string/no_point"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:fontFamily="monospace" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/log_title"
        android:textColor="#7A7A7A"
        android:textSize="12sp" />

    <ScrollView
        android:id="@+id/scrollLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#101113"
        android:padding="8dp">

        <TextView
            android:id="@+id/textLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#9BB8A9"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonCopy"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/action_copy" />

        <Button
            android:id="@+id/buttonClear"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/action_clear" />
    </LinearLayout>

</LinearLayout>
