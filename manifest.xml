<?xml version="1.0"?>
<!--
  TreeMapper GPS for Garmin.

  Two permissions, no more. Every permission is shown to the user in the store
  before install and costs conversion, so the app asks for exactly what it uses:

    Positioning     Toybox.Position. enableLocationEvents() is limited to
                    device apps and widgets, which is why this app is a
                    watch-app and why a background service cannot do this work.
    Communications  Toybox.Communications, for the Bluetooth link to the
                    TreeMapper phone app.

  No Background permission: everything happens in the foreground while the app
  is open. No Fit permission: the app does not record activities, and holding
  Fit would move it into the device's Activities list instead of the app list.

  minApiLevel 3.0.8 is set by GPSMAP 66 and 86, the oldest handhelds that can
  run this app at all. It used to be 3.3.6, the floor for the multi band GNSS
  configuration constants, which excluded them. GpsService now treats those
  constants as optional rather than assumed: it names none of them until
  `Position has` confirms them and omits the :configuration key entirely when
  they are absent, so one binary covers both generations. Handhelds are the
  priority for this app, so the floor follows them.

  Set the real product list with "Monkey C: Edit Products" so the ids are
  validated against your SDK.

  version is the string the Connect IQ Store shows for this build. It must be
  three dot separated numbers. 2.0.0 is the streaming release: version 1 was
  the published one shot capture app, and protocol v2 replaced request and
  response with a 1 Hz stream, which is a breaking change for any phone client.
  The store also keeps its own internal version for update detection, so this
  number is for people, not for the updater. Bump it on every store upload.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        id="a7f3c81e6b2d4f9ea05c73819d4e6b21"
        type="watch-app"
        name="@Strings.AppName"
        entry="TreeMapperApp"
        launcherIcon="@Drawables.LauncherIcon"
        version="2.0.0"
        minApiLevel="3.0.8">

        <iq:products>
            <!-- Watches. Round or square, roughly 1:1, 208 to 454 px. -->
            <iq:product id="fenix7"/>
            <iq:product id="fenix7x"/>
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fr955"/>
            <iq:product id="fr965"/>
            <iq:product id="epix2"/>
            <iq:product id="venu3"/>
            <iq:product id="vivoactive5"/>
            <iq:product id="instinct2x"/>

            <!--
              Handhelds, the priority for this app. Every Connect IQ handheld
              whose firmware carries Communications.transmit and
              registerForPhoneAppMessages is here. That is the real gate, and
              the SDK device database is where to check it: a device whose
              api.debug.xml has no registerForPhoneAppMessages cannot talk to
              the phone, whatever the marketing page says.

              Two generations, and they differ in one way that matters:

                gpsmaph1, etrextouch   Connect IQ 5.x. Full Position
                                       configuration API, so the app can ask
                                       for multi band (L1 + L5) and report it.

                gpsmap86, gpsmap66     Connect IQ 3.0.8. No Position
                                       configuration API at all, not even
                                       CONFIGURATION_GPS. The app runs on the
                                       device's own constellation choice and
                                       reports single band, because there is
                                       no way to ask or to check. See
                                       GpsService.bestConfiguration.

              GPSMAP 67/67i, Montana 7, Oregon 7xx and Rino 7xx are NOT
              here. Their firmware has no phone app messaging at all, so
              PhoneLink cannot work on them. The compiler does not catch
              this, it fails at runtime, so do not add them back.

              GPSMAP 65/65s is not a Connect IQ device at all. It has no
              entry in the SDK device database, runs no Connect IQ apps of
              any kind, and Garmin Connect reports it as incompatible. No
              manifest change can reach it.
            -->
            <iq:product id="gpsmaph1"/>
            <iq:product id="etrextouch"/>
            <iq:product id="gpsmap86"/>
            <iq:product id="gpsmap66"/>
        </iq:products>

        <iq:permissions>
            <iq:uses-permission id="Positioning"/>
            <iq:uses-permission id="Communications"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>

        <iq:barrels/>
    </iq:application>
</iq:manifest>
